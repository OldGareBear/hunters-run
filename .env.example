# Copy to .env for local development. Every value here is a placeholder.
# Never commit a real .env file.
#
# In production, put the secrets (marked [secret]) in one AWS Secrets Manager
# secret as a JSON object, e.g. {"SECRET_KEY": "...", "DATABASE_URL": "..."},
# and point the app at it. Environment variables still win over the secret.
# AWS_SECRETS_MANAGER_SECRET_ID=hoa-portal/production

APP_ENV=development            # development | test | production
HOA_NAME="Your HOA"              # shown in the header and emails
BASE_URL=http://localhost:8000 # used in email links
SECRET_KEY=change-me           # [secret] production: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SESSION_COOKIE_SECURE=false    # production: true (requires HTTPS)

# Database. SQLite works for local dev; production requires Postgres with pgvector.
DATABASE_URL=sqlite:///./dev.db   # [secret] in production (contains the DB password)
# DATABASE_URL=postgresql+psycopg://hoa:hoa@localhost:5432/hoa

# Where documents come from:
#   dropbox: the board keeps them in a Dropbox folder; the portal reads them (read-only)
#            and the subfolder a file is in decides who can see it. Production setting.
#   upload:  people upload through the portal (local dev, or S3 below).
DOCUMENT_SOURCE=upload
# DROPBOX_APP_KEY=placeholder
# DROPBOX_APP_SECRET=          # [secret]
# DROPBOX_REFRESH_TOKEN=       # [secret] `python -m app.cli dropbox-auth`
# DROPBOX_ROOT="/HOA Portal"
# DROPBOX_FOLDER_ROLES='{"Everyone": ["board", "management", "homeowner"], "Board and Management": ["board", "management"], "Board": ["board"], "Management": ["management"]}'
# DROPBOX_SYNC_MINUTES=10
# DROPBOX_MAX_FILE_MB=50

# Storage for portal uploads (DOCUMENT_SOURCE=upload): local (encrypted on disk) or s3.
STORAGE_BACKEND=local
STORAGE_ENCRYPTION_KEY=        # [secret] `python -m app.cli generate-key`
LOCAL_STORAGE_DIR=./var/documents
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# S3_PREFIX=documents/
# S3_KMS_KEY_ID=alias/hoa-portal-documents
MAX_UPLOAD_MB=25

# How the chatbot finds handbook passages:
#   keyword: Postgres full-text search. No extra account. The AWS deploy uses this.
#   vector:  embeddings (needs EMBEDDING_PROVIDER=voyage in production).
RETRIEVAL=vector
# Embeddings: hashing (offline, dev only) or voyage.
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=1024
# VOYAGE_API_KEY=              # [secret]

# Chatbot: anthropic or offline (extractive, no API calls).
LLM_PROVIDER=offline
# ANTHROPIC_API_KEY=           # [secret] use a separate Console key on prepaid credits
ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_EFFORT=medium      # default; low on models that can't turn thinking off (Opus 5.5)
ANTHROPIC_THINKING=false       # extended thinking costs more tokens; off by default
ANTHROPIC_MAX_TOKENS=1000      # longest answer, in tokens (at least 4000 on Opus 5.5)
# Usage limits. The month's spend is estimated from token counts and the model's prices,
# which the portal knows for claude-haiku-5-5, claude-sonnet-5-5 and claude-opus-5-5.
CHAT_DAILY_LIMIT_PER_USER=20
CHAT_MONTHLY_BUDGET_USD=5
# For any other model, set both (USD per million tokens):
# CHAT_PRICE_INPUT_PER_MTOK=
# CHAT_PRICE_OUTPUT_PER_MTOK=

# Email: console (prints to the log), smtp, ses or postmark.
EMAIL_PROVIDER=console
EMAIL_FROM="Your HOA <no-reply@example.com>"
EMAIL_REPLY_TO=
EMAIL_SEND_INLINE=true         # production: false, and run the worker
# SMTP_HOST= / SMTP_PORT=587 / SMTP_USERNAME= / SMTP_PASSWORD= [secret]
# SES_REGION=us-east-1 / SES_CONFIGURATION_SET=
# POSTMARK_SERVER_TOKEN=       # [secret]

# Asking management (one email per question, with the asker copied)
MANAGEMENT_NOTIFY_EMAILS=      # comma-separated extra addresses, e.g. the management office inbox
ESCALATIONS_PER_DAY=5          # most messages one person can send to management in 24 hours

# --- Running on AWS Lambda (set by infra/app; see DEPLOY.md) ---
# DATABASE_NULL_POOL=true        # no idle connections, so a serverless database can sleep
# TASKS_FUNCTION_NAME=           # background work goes to this function instead of the request
# DOWNLOAD_REDIRECT_OVER_MB=4    # bigger Dropbox files download straight from Dropbox

# --- Amenity booking ---
HOA_TIMEZONE=America/New_York
# Leave AMENITIES unset to use the defaults (one tennis court and a clubhouse).
# Every rule is listed in app/amenities.py. Example override:
# AMENITIES={"tennis":{"label":"Tennis court","spaces":{"tennis":"Tennis court"},"max_per_week":2}}

# `python -m app.cli seed` password for the demo accounts (dev only)
SEED_DEMO_PASSWORD=
